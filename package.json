{
  "name": "nodegraph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nodegraph": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
